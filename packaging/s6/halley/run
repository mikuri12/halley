#!/bin/sh
# Example s6 longrun service for a user-owned supervision tree. A system-level
# seat manager such as seatd or elogind must already be running.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Halley
export XDG_SESSION_DESKTOP=Halley
export DESKTOP_SESSION=Halley

exec /usr/bin/halley --session
