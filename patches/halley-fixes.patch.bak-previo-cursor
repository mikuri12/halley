+/// True when the current render monitor has a settled fullscreen window (game mode).
+///
+/// Used by the frame builder to suppress the Top/Overlay layer-shell surfaces (the
+/// Noctalia bar, notifications, launcher) so a fullscreen app covers them like every
+/// other WM does. Gated on the visual animation being idle so the bar re-appears
+/// while the fullscreen zooms out on exit instead of popping back only at the end.
+pub(crate) fn current_monitor_has_settled_fullscreen(st: &Halley, now: Instant) -> bool {
+    let monitor = st.model.monitor_state.current_monitor.as_str();
+    let Some(&node_id) = st.model.fullscreen_state.fullscreen_active_node.get(monitor) else {
+        return false;
+    };
+    !fullscreen_visual_animation_active_for_node_on_current_monitor_at(st, node_id, now)
+}
